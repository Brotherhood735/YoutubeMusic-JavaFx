<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.unimusic.Controller.MidiPlayerController"
      style="-fx-padding: 20; -fx-background-color: #222; -fx-text-fill: #fff;">

    <Button fx:id="playButton" text="Play"/>
    <Button fx:id="pauseButton" text="Pause"/>

    <Label text="Volume:"/>
    <Slider fx:id="volumeSlider"/>

    <Label text="Channel 0 Instrument:"/>
    <ComboBox fx:id="instrumentBox"/>

</VBox>
