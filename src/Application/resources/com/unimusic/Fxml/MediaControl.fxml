<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" prefHeight="90" spacing="20" styleClass="player-bar" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unimusic.Controller.MediaControlController">
   <padding>
      <Insets topRightBottomLeft="20" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" prefWidth="300" spacing="15">
         <children>
            <Region prefHeight="56" prefWidth="56" styleClass="player-thumbnail" />
            <VBox spacing="5">
               <children>
                  <Label fx:id="nowPlayingTitle" styleClass="now-playing-title" text="Ask Them" />
                  <Label fx:id="nowPlayingArtist" styleClass="now-playing-artist" text="Jxggi and Dishant • 3.4M views" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox alignment="CENTER" spacing="10">
         <children>
            <HBox alignment="CENTER" spacing="20">
               <children>
                  <Button onAction="#onPrevious" styleClass="control-btn" text="⏮" />
                  <Button fx:id="playPauseBtn" onAction="#onPlayPause" styleClass="control-btn" text="▶" />
                  <Button onAction="#onNext" styleClass="control-btn" text="⏭" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
               <children>
                  <Label fx:id="timeStart" styleClass="time-label" text="1:09" />
                  <Slider fx:id="progressBar" max="100" min="0" prefWidth="500" value="48" />
                  <Label fx:id="timeEnd" styleClass="time-label" text="2:25" />
               </children>
            </HBox>
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" prefWidth="300" spacing="10">
         <children>
            <Button fx:id="muteAudibleBtn" onAction="#onMuteAudible" styleClass="small-btn" text="🔊" />
            <Slider fx:id="volumeSlider" max="100" min="0" prefWidth="100" value="70" />
         </children>
      </HBox>
   </children>
</HBox>
