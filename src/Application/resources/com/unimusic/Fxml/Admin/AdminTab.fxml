<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unimusic.Controller.Admin.AdminTabController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="15.0">
          <padding>
              <Insets bottom="20" left="20" right="20" top="20" />
          </padding>
      
          <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Richieste di Registrazione" />
      
          <TableView id="userTable" fx:id="requestTable" styleClass="table" stylesheets="@../../Css/Table.css" VBox.vgrow="ALWAYS">
              <columns>
                  <TableColumn fx:id="colUsername" prefWidth="200.0" text="Username" />
      
                  <TableColumn fx:id="colAdmin" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Rendi Admin" />
      
                  <TableColumn fx:id="colActions" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Approva / Rifiuta" />
              </columns>
              <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
          </TableView>
      </VBox>
      <VBox alignment="TOP_CENTER" layoutX="10.0" layoutY="10.0" spacing="15.0">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Utenti" />
            <TableView id="userTable" fx:id="userManageTable" styleClass="table" stylesheets="@../../Css/Table.css" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colUsername1" prefWidth="200.0" text="Username" />
                  <TableColumn fx:id="colAdmin1" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Rendi Admin" />
                  <TableColumn fx:id="colEliminate1" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Elimina" />
                  <TableColumn fx:id="colActions1" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Conferma" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</HBox>
