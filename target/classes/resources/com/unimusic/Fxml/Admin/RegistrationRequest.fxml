<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unimusic.Controller.Admin.RegistrationRequestController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Richieste di Registrazione" />

    <TableView id="userTable" fx:id="userTable" styleClass="table" stylesheets="@../../Css/Table.css" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUsername" prefWidth="200.0" text="Username" />

            <TableColumn fx:id="colAdmin" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Rendi Admin" />

            <TableColumn fx:id="colActions" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Approva / Rifiuta" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
