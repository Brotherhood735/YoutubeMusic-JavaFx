<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unimusic.Controller.HomeController">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="200" spacing="20" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="logo-icon" text="▶" />
                <Label styleClass="logo-text" text="Music" />
            </HBox>

            <Separator />

            <!-- Menu -->
            <VBox fx:id="menuContainer" spacing="5">
                <HBox onMouseClicked="#onHomeClick" styleClass="menu-item, menu-item-active">
                    <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                    <Label styleClass="menu-label" text="🏠 Home" />
                </HBox>
                <HBox onMouseClicked="#onExploreClick" styleClass="menu-item">
                    <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                    <Label styleClass="menu-label" text="🔍 Explore" />
                </HBox>
                <HBox onMouseClicked="#onLibraryClick" styleClass="menu-item">
                    <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                    <Label styleClass="menu-label" text="📚 Library" />
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fx:id="mainViewArea" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="500.0" prefWidth="600.0" styleClass="scroll-pane" />
    </center>

    <!-- Bottom Player Bar -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="90" spacing="20" styleClass="player-bar">
            <padding>
                <Insets topRightBottomLeft="20" />
            </padding>

            <!-- Now Playing -->
            <HBox alignment="CENTER_LEFT" prefWidth="300" spacing="15">
                <Region prefHeight="56" prefWidth="56" styleClass="player-thumbnail" />
                <VBox spacing="5">
                    <Label fx:id="nowPlayingTitle" styleClass="now-playing-title" text="Ask Them" />
                    <Label fx:id="nowPlayingArtist" styleClass="now-playing-artist" text="Jxggi and Dishant • 3.4M views" />
                </VBox>
            </HBox>

            <!-- Player Controls -->
            <VBox alignment="CENTER" spacing="10">
                <HBox alignment="CENTER" spacing="20">
                    <Button onAction="#onPrevious" styleClass="control-btn" text="⏮" />
                    <Button fx:id="playPauseBtn" onAction="#onPlayPause" styleClass="control-btn" text="▶" />
                    <Button onAction="#onNext" styleClass="control-btn" text="⏭" />
                </HBox>

                <HBox alignment="CENTER" spacing="10">
                    <Label fx:id="timeStart" styleClass="time-label" text="1:09" />
                    <Slider fx:id="progressBar" max="100" min="0" prefWidth="500" value="48" />
                    <Label fx:id="timeEnd" styleClass="time-label" text="2:25" />
                </HBox>
            </VBox>

            <!-- Volume Controls -->
            <HBox alignment="CENTER_RIGHT" prefWidth="300" spacing="10">
                <Button styleClass="small-btn" text="🔊" />
                <Slider fx:id="volumeSlider" max="100" min="0" prefWidth="100" value="70" />
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
