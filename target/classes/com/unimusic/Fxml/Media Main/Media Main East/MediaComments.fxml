<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="mainArea" alignment="BASELINE_CENTER" maxHeight="1.7976931348623157E308" prefHeight="511.0" prefWidth="424.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unimusic.Controller.Media.Comment.MediaCommentsController">
   <children>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="424.0" spacing="10.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" prefHeight="70.0" prefWidth="120.0" text="Commenti">
               <font>
                  <Font size="10.0" />
               </font>
            </Button>
            <Button layoutX="162.0" layoutY="15.0" mnemonicParsing="false" onAction="#onNotes" prefHeight="70.0" prefWidth="120.0" text="Note">
               <font>
                  <Font size="10.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="5.0" top="5.0" />
         </padding>
      </HBox>
      <ScrollPane fx:id="commentsAreaParent" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" prefHeight="460.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="commentsArea" alignment="TOP_CENTER" prefHeight="460.0" prefWidth="423.0" styleClass="v-box" />
         </content>
      </ScrollPane>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="300.0">
         <children>
            <TextField fx:id="commentField" alignment="TOP_LEFT" prefHeight="42.0" prefWidth="316.0" promptText="Type your comment here...">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </TextField>
            <Button mnemonicParsing="false" onAction="#sendComment" text="Send" />
         </children>
      </HBox>
   </children>
</VBox>
