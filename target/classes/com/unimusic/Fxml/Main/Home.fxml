<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="homeContainer" prefHeight="700.0" prefWidth="1000.0" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unimusic.Controller.HomeController">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="200" spacing="20" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="logo-icon" text="▶" />
                <Label styleClass="logo-text" text="Music" />
            </HBox>

            <Separator />

            <!-- Menu -->
            <VBox fx:id="menuContainer" spacing="5">
                <HBox onMouseClicked="#onHomeClick" styleClass="menu-item, menu-item-active">
                    <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                    <Label styleClass="menu-label" text="Home" />
                </HBox>
                <HBox onMouseClicked="#onConcertClick" styleClass="menu-item">
                    <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                    <Label styleClass="menu-label" text="Concerts" />
                </HBox>
                <HBox onMouseClicked="#onAddNewMedia" styleClass="menu-item">
                    <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                    <Label styleClass="menu-label" text="Add Media" />
                </HBox>
            <HBox fx:id="adminButton" layoutX="10.0" layoutY="102.0" onMouseClicked="#onAdminClick" styleClass="menu-item">
               <padding>
                  <Insets bottom="12" left="15" right="15" top="12" />
               </padding>
               <children>
                  <Label styleClass="menu-label" text="Admin" />
               </children>
            </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fx:id="mainViewArea" prefHeight="500.0" prefWidth="600.0" />
    </center>

</BorderPane>
