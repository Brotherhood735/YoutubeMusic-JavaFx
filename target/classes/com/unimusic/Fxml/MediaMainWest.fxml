<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<VBox fx:id="mainArea" alignment="TOP_CENTER" prefHeight="600.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unimusic.Controller.MediaMainWestController">
   <children>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" VBox.vgrow="NEVER">
         <children>
            <Button maxWidth="100.0" mnemonicParsing="false" onAction="#onVideoRequest" text="Video" />
            <Button layoutX="10.0" layoutY="10.0" maxWidth="100.0" mnemonicParsing="false" text="Audio" />
            <Button layoutX="62.0" layoutY="10.0" maxWidth="100.0" mnemonicParsing="false" text="Youtube" />
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <MediaView fx:id="mediaView" fitHeight="200.0" fitWidth="200.0">
         <VBox.margin>
            <Insets left="10.0" right="10.0" />
         </VBox.margin>
      </MediaView>
   </children>
</VBox>
